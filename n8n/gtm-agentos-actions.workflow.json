      "parameters": {
        "jsCode": "const crypto = require('crypto');\nconst { URL } = require('url');\nconst secret = $env.N8N_WEBHOOK_SECRET;\nconst callbackUrl = $env.GTM_AGENTOS_CALLBACK_URL;\nif (!secret || !callbackUrl) throw new Error('Callback environment is not configured');\nconst parsedUrl = new URL(callbackUrl);\nconst localHosts = new Set(['localhost', '127.0.0.1', '::1']);\nif (parsedUrl.protocol !== 'https:' && !localHosts.has(parsedUrl.hostname)) throw new Error('Callback URL must use HTTPS');\nif (parsedUrl.username || parsedUrl.password || parsedUrl.search || parsedUrl.hash) throw new Error('Callback URL cannot contain credentials, query, or fragment');\nconst callback = { action_id: $json.action_id, status: 'completed', external_reference: 'replace-with-provider-reference', metadata: { workflow: 'gtm-agentos-actions' } };\nconst rawBody = JSON.stringify(callback);\nconst timestamp = String(Math.floor(Date.now() / 1000));\nconst signature = 'sha256=' + crypto.createHmac('sha256', secret).update(timestamp + '.' + rawBody).digest('hex');\nreturn [{ json: { callbackUrl, rawBody, timestamp, signature, action_id: $json.action_id } }];"
      },
